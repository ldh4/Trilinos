exe krino
  :
    $(krino-root)/krino/Apps_krino.cpp
    krino_parser
    krino_region
  : <tag>@sierra-exec-tag
  ;
  
exe krino_unit
  :
    $(krino-root)/krino/unit_tests/Akri_Unit_main.cpp
    [ glob $(krino-root)/krino/unit_tests/*.cpp ]
    /sierra/stk_unit_test_utils//stk_unit_test_utils
    krino_rebalance_utils
    krino_region
