exe rfrealize
  :
    [ glob $(percept-root-src)/percept/uq/main/RFRealizeMain.cpp ]
    percept_uq
  : <tag>@sierra-exec-tag
  ;

lib percept
  :
    [ ifdevbuild
    # Any parameters within this 'ifdevbuild' block apply to development
    # builds only and will not be present for user builds.
